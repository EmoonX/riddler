{
  "manifest_version": 2,
  "name": "Riddler",
  "description": "Browser extension for Riddler, the online riddle enhancer.",
  "version": "0.7.7.4",

  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ],
  "icons": {
    "16": "images/icons/action/default16.png",
    "32": "images/icons/action/default32.png",
    "48": "images/icons/action/default48.png",
    "128": "images/icons/action/default128.png"
  },
  "browser_action": {
    "default_icon": "images/icons/action/default32.png",
    "default_title": "Riddler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "thirdParty/jquery.min.js",
        "content/port.js",
        "content/blacklist.js",
        "content/credentials.js"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{f91c9d12-dc58-40cf-bb34-8bf56bb9d6a2}",
      "strict_min_version": "153.0"
    }
  }
}
